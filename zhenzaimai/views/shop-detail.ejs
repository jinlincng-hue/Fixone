<%- include("partials/header", { title, page }) %>
<section class="shop-profile">
  <img src="<%= shop.cover_image || shop.logo_image || "/assets/images/shop-placeholder.svg?v=2" %>" alt="<%= shop.name %>">
  <div><div class="item-title-row"><h1><%= shop.name %></h1><% if (shop.business_mode === 'home_shop') { %><span class="verify neighbour">乡邻小铺</span><% } else { %><span class="verify"><%= shop.verified ? '平台已核验' : '暂未认证' %></span><% } %></div>
    <% if (shop.business_mode === 'home_shop') { %><p class="shop-mode-label">乡邻发布</p><p><%= shop.description || '本地乡邻小铺' %></p><dl class="detail-list compact-list"><dt>所在村</dt><dd><%= shop.village || '高桥镇' %></dd><dt>自提方式</dt><dd>约定自提点：<%= shop.pickup_location || '请联系卖家' %></dd><dt>具体位置</dt><dd>具体位置请联系卖家</dd><dt>联系方式</dt><dd><%= shop.public_phone ? phoneForPage(shop.phone) : '卖家暂未公开电话' %></dd></dl><% } else { %><p><%= shop.business_scope %></p><p class="shop-mode-label">实体门店</p><dl class="detail-list compact-list"><dt>地址</dt><dd><%= shop.address %></dd><dt>营业状态</dt><dd><%= shop.business_state === 'open' ? '今日营业' : shop.business_state === 'rest' ? '今日休息' : '临时休息' %></dd><dt>电话</dt><dd><%= shop.public_phone ? phoneForPage(shop.phone) : '商家暂未公开电话' %></dd><% if (shop.contact_wechat) { %><dt>商家微信</dt><dd><%= currentUser ? shop.contact_wechat : '登录后查看' %></dd><% } %><dt>营业时间</dt><dd><%= shop.business_hours || '请联系商家确认' %></dd><dt>配送范围</dt><dd><%= shop.delivery_area %></dd></dl><% } %>
  </div>
</section>
<% if (shop.description || (shop.business_mode === 'verified_store' && media.length)) { %><section class="shop-intro"><div><h2><%= shop.business_mode === 'home_shop' ? '小铺介绍' : '店铺简介' %></h2><p><%= shop.description || '店铺暂未填写简介。' %></p></div><% if (shop.business_mode === 'verified_store' && media.length) { %><div class="shop-interior-gallery"><% media.forEach((item) => { %><img src="<%= item.file_path %>" alt="<%= shop.name %>店内实拍"><% }) %></div><% } %></section><% } %>
<div class="section-heading"><h2><%= shop.business_mode === 'home_shop' ? '小铺发布' : '店内商品' %></h2></div><section class="product-grid wide"><% products.forEach((product) => { %><%- include('partials/product-card', { product }) %><% }) %></section>
<% if (!products.length) { %><%- include('partials/empty', { message: '暂时没有已公开的发布内容。', actionHref: '/wanted/new', actionText: '帮我问全镇' }) %><% } %>
<% if (services.length) { %><div class="section-heading"><h2>本地服务</h2></div><section class="service-grid"><% services.forEach((service) => { %><article class="service-card"><img src="<%= service.image %>" alt="<%= service.title %>"><h3><%= service.title %></h3><p><%= service.description %></p><p class="muted"><%= service.business_hours %> · <%= phoneForPage(service.phone) %></p></article><% }) %></section><% } %>
<%- include("partials/footer") %>
