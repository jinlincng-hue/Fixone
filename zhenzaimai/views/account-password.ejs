<%- include("partials/header", { title, page }) %>

<section class="account-subpage">
  <header class="account-subpage-header">
    <a class="back-icon" href="/account/security" aria-label="返回账户安全" title="返回账户安全">←</a>
    <div><p class="eyebrow">账户安全</p><h1>修改密码</h1></div>
  </header>

  <section class="account-form-section">
    <form action="/account/password" method="post" class="stack-form">
      <label>当前密码<input name="current_password" type="password" required autocomplete="current-password"></label>
      <label>新密码<input name="new_password" type="password" required minlength="8" autocomplete="new-password"></label>
      <label>确认新密码<input name="confirm_password" type="password" required minlength="8" autocomplete="new-password"></label>
      <button class="button primary" type="submit">更新密码</button>
    </form>
  </section>
</section>

<%- include("partials/footer") %>
