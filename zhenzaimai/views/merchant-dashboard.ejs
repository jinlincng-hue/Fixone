<%- include("partials/header", { title, page }) %>
<section class="merchant-dashboard-page">
  <header class="merchant-dashboard-header">
    <a class="back-icon" href="/account/shops" aria-label="返回我的店铺" title="返回我的店铺">←</a>
    <div>
      <p class="eyebrow">我的店铺</p>
      <h1><%= shop ? shop.name : "店铺管理" %></h1>
      <p class="merchant-dashboard-subtitle"><%= shop ? (shop.business_mode === "home_shop" ? "乡邻小铺管理" : "实体店经营管理") : "管理店铺资料和发布内容" %></p>
    </div>
    <% if (shop) { %><a class="merchant-dashboard-public-link" href="/shops/<%= shop.id %>">店铺页</a><% } %>
  </header>

  <% if (shop) { %>
    <nav class="merchant-mobile-shortcuts" aria-label="店铺快捷操作">
      <% if (shop.business_mode === "home_shop") { %>
        <a href="#neighbour-publish">发布内容</a>
        <a href="#products">我的发布</a>
      <% } else if (canManageShop) { %>
        <a href="#new-product">上传商品</a>
        <a href="#products">商品管理</a>
        <a href="#business-state">今日营业</a>
        <a href="#collaborators">协作管理</a>
      <% } else { %>
        <a href="#products">商品状态</a>
      <% } %>
    </nav>
  <% } %>

  <section class="dashboard-grid merchant-dashboard-grid">
  <aside class="dashboard-side merchant-dashboard-side">
    <h2>店铺状态</h2>
    <% if (managedShops.length > 1) { %>
      <label class="shop-switcher">当前管理店铺
        <select onchange="window.location.href = '/merchant/dashboard?shop=' + this.value">
          <% managedShops.forEach((managedShop) => { %>
            <option value="<%= managedShop.id %>" <%= shop && managedShop.id === shop.id ? 'selected' : '' %>><%= managedShop.name %></option>
          <% }) %>
        </select>
      </label>
    <% } %>
    <% if (application) { %>
      <p>认证状态：<strong><%= statusLabel(application.status) %></strong></p>
      <% if (application.status === "rejected") { %><p>拒绝理由：<%= application.rejection_reason %></p><% } %>
    <% } else if (!shop) { %>
      <p>尚未提交入驻申请。</p>
    <% } %>
    <% if (shop) { %>
      <p><strong><%= shop.name %></strong></p>
      <p class="verify <%= shop.business_mode === 'home_shop' ? 'neighbour' : '' %>"><%= shop.business_mode === 'home_shop' ? "乡邻发布" : shop.verified ? "平台已核验" : "实体店审核中" %></p>
      <% if (shop.business_mode === 'verified_store') { %><p><%= shop.delivery_area %></p><% } %>
      <% if (canManageShop && shop.business_mode === 'verified_store') { %>
      <section class="dashboard-block" id="business-state">
        <h2>今日营业</h2>
        <p><strong><%= shop.business_state === "open" ? "今日营业" : shop.business_state === "rest" ? "今日休息" : "临时休息" %></strong></p>
        <form action="/merchant/shops/<%= shop.id %>/business-state" method="post" class="quick-state-actions">
          <button class="button light small" name="business_state" value="open" type="submit">今日营业</button>
          <button class="button outline small" name="business_state" value="rest" type="submit">今日休息</button>
        </form>
      </section>
      <section class="dashboard-block" id="barcode">
        <h2>快捷开始</h2>
        <a class="button primary small" href="#products">拍照发布商品</a>
        <a class="button outline small" href="/merchant/barcode">扫条形码上架</a>
        <a class="button light small" href="/shops/<%= shop.id %>">暂时只展示店铺</a>
      </section>
      <section class="dashboard-block" id="collaborators">
        <h2>邀请协作人</h2>
        <p class="muted">受邀好友只能修改本店商品的上下架和库存状态，不能修改店铺资料、商品详情或邀请其他人。</p>
        <form action="/merchant/shops/<%= shop.id %>/collaborators" method="post" class="collaborator-invite-form">
          <input name="username" required maxlength="60" placeholder="输入好友已注册的用户名">
          <button class="button outline small" type="submit">邀请好友</button>
        </form>
        <div class="collaborator-list">
          <% collaborators.forEach((member) => { %>
            <div><span><strong><%= member.display_name || member.username %></strong><small><%= member.role === "owner" ? "店主" : "商品状态协作人" %></small></span>
              <% if (member.role === "clerk") { %><form action="/merchant/shops/<%= shop.id %>/collaborators/<%= member.user_id %>/remove" method="post"><button class="button light small" type="submit">移除</button></form><% } %>
            </div>
          <% }) %>
        </div>
      </section>
      <% } %>
    <% } %>
  </aside>

  <section class="dashboard-main merchant-dashboard-main" id="products">
    <% if (!shop) { %>
      <%- include("partials/empty", { message: "商家认证通过后才能发布和管理商品。", actionHref: "/merchant/apply", actionText: "提交入驻申请" }) %>
    <% } else if (shop.business_mode === 'home_shop') { %>
      <section class="home-shop-dashboard" id="neighbour-publish">
        <p class="eyebrow">乡邻小铺</p>
        <h2>发布乡邻内容</h2>
        <p class="muted">自家农货、闲置物品和本地服务都会先进入审核；审核通过仅表示发布信息已审核，不代表平台保证质量。</p>
        <div class="home-shop-dashboard-actions"><a class="button primary" href="/merchant/home-shop/<%= shop.id %>/publish?type=local_produce">卖自家东西</a><a class="button outline" href="/merchant/home-shop/<%= shop.id %>/publish?type=secondhand">卖闲置物品</a><a class="button light" href="/merchant/home-shop/<%= shop.id %>/publish?type=service">发布本地服务</a></div>
      </section>
      <section class="dashboard-block"><h2>我的发布</h2><div class="table-wrap"><table><thead><tr><th>内容</th><th>类型</th><th>审核状态</th><th>审核说明</th><th>操作</th></tr></thead><tbody><% homeListings.forEach((listing) => { %><tr><td data-label="内容"><a href="/listings/<%= listing.id %>"><%= listing.name %></a></td><td data-label="类型"><%= listing.listing_type === 'local_produce' ? '自家农货' : '闲置二手' %></td><td data-label="审核状态"><%= statusLabel(listing.publication_status || listing.status) %></td><td data-label="审核说明"><%= listing.review_reason || '—' %></td><td class="table-actions" data-label="操作"><a class="button light small" href="/listings/<%= listing.id %>/edit">修改</a></td></tr><% }) %><% services.forEach((service) => { %><tr><td data-label="内容"><%= service.title %></td><td data-label="类型">本地服务</td><td data-label="审核状态"><%= statusLabel(service.publication_status || service.status) %></td><td data-label="审核说明"><%= service.review_reason || '—' %></td><td class="table-actions" data-label="操作"><a class="button light small" href="/merchant/services/<%= service.id %>/edit">修改</a></td></tr><% }) %></tbody></table></div></section>
    <% } else if (!canManageShop) { %>
      <h2>商品状态</h2>
      <p class="muted">你是受邀协作人，只能修改商品上下架和库存状态。</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>商品</th><th>库存状态</th><th>上架状态</th></tr></thead>
          <tbody>
            <% products.forEach((product) => { %>
              <tr>
                <td data-label="商品"><a href="/products/<%= product.id %>"><%= product.name %></a></td>
                <td data-label="库存状态"><form action="/merchant/products/<%= product.id %>/stock-status" method="post" class="status-edit-form"><input name="stock_status" value="<%= product.stock_status %>" maxlength="40"><button class="button light small" type="submit">保存</button></form></td>
                <td class="table-actions" data-label="上架状态"><form action="/merchant/products/<%= product.id %>/status" method="post" class="inline-form"><input type="hidden" name="status" value="<%= product.status === "active" ? "inactive" : "active" %>"><button class="button outline small" type="submit"><%= product.status === "active" ? "下架" : "上架" %></button></form></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <h2 id="new-product">新增商品</h2>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>
      <form action="/merchant/products" method="post" enctype="multipart/form-data" class="stack-form product-form">
        <input type="hidden" name="shop_id" value="<%= shop.id %>">
        <div class="form-grid-two">
          <label>商品名称<input name="name" required maxlength="120"></label>
          <label>分类
            <select name="category_id">
              <% categories.forEach((category) => { %><option value="<%= category.id %>"><%= category.name %></option><% }) %>
            </select>
          </label>
        </div>
        <div class="form-grid-two">
          <label>价格<input name="price" type="number" min="0" step="0.01" required></label>
          <label>计价单位<input name="unit" maxlength="30" placeholder="斤、件、台"></label>
        </div>
        <label>规格<input name="spec" maxlength="120" placeholder="如 5L/桶"></label>
        <label>描述<textarea name="description" rows="3" maxlength="1200" required></textarea></label>
        <div class="form-grid-two">
          <label>库存状态<input name="stock_status" maxlength="40" value="有货"></label>
          <label>所属村庄<input name="village" maxlength="80" value="高桥镇"></label>
        </div>
        <label>联系电话<input name="contact_phone" maxlength="40" value="<%= shop.phone %>"></label>
        <%- include("partials/listing-image-upload", { existingImages: [] }) %>
        <div class="check-row">
          <label><input type="checkbox" name="pickup" checked> 支持自提</label>
          <label><input type="checkbox" name="delivery" checked> 支持配送</label>
        </div>
        <label>配送范围<input name="delivery_area" maxlength="160" value="<%= shop.delivery_area %>"></label>
        <button class="button primary" type="submit">发布商品</button>
      </form>

      <h2>商品管理</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>商品</th><th>价格</th><th>库存</th><th>状态</th><th>操作</th></tr></thead>
          <tbody>
            <% products.forEach((product) => { %>
              <tr>
                <td data-label="商品"><a href="/products/<%= product.id %>"><%= product.name %></a></td>
                <td data-label="价格"><%= yuan(product.price) %>/<%= product.unit %></td>
                <td data-label="库存"><%= product.stock_status %></td>
                <td data-label="状态"><%= statusLabel(product.status) %></td>
                <td class="table-actions" data-label="操作">
                  <a class="button light small" href="/merchant/products/<%= product.id %>/edit">编辑</a>
                  <form action="/merchant/products/<%= product.id %>/status" method="post" class="inline-form">
                    <input type="hidden" name="status" value="<%= product.status === "active" ? "inactive" : "active" %>">
                    <button class="button outline small" type="submit"><%= product.status === "active" ? "下架" : "上架" %></button>
                  </form>
                  <form action="/merchant/products/<%= product.id %>/delete" method="post" class="inline-form" onsubmit="return confirm('确定删除这个商品吗？商品图片和评论也会一并删除。')">
                    <button class="button danger small" type="submit">删除</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <section class="dashboard-block" id="services">
        <h2>发布便民服务</h2>
        <form action="/merchant/services" method="post" class="stack-form">
          <input type="hidden" name="shop_id" value="<%= shop.id %>">
          <div class="form-grid-two">
            <label>服务类型
              <select name="type">
                <% serviceTypes.forEach((type) => { %><option value="<%= type %>"><%= type %></option><% }) %>
              </select>
            </label>
            <label>服务名称<input name="title" maxlength="120" placeholder="如 家电维修、送水到家"></label>
          </div>
          <label>服务说明<textarea name="description" rows="3" maxlength="800" required placeholder="说明服务内容、预约方式、费用说明等"></textarea></label>
          <div class="form-grid-two">
            <label>联系电话<input name="phone" maxlength="40" value="<%= shop.phone %>"></label>
            <label>营业时间<input name="business_hours" maxlength="120" value="<%= shop.business_hours %>"></label>
          </div>
          <div class="form-grid-two">
            <label>服务范围<input name="delivery_area" maxlength="180" value="<%= shop.delivery_area %>"></label>
            <label>所在村庄<input name="village" maxlength="80" value="<%= currentUser.village %>"></label>
          </div>
          <p class="muted">药店送药只做认证药店电话和配送范围展示，不支持在线售药、处方上传或支付。</p>
          <button class="button primary" type="submit">发布服务</button>
        </form>

        <h2>服务管理</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>服务</th><th>类型</th><th>电话</th><th>状态</th><th>操作</th></tr></thead>
            <tbody>
              <% services.forEach((service) => { %>
                <tr>
                  <td data-label="服务"><%= service.title %><p class="muted"><%= service.delivery_area %></p></td>
                  <td data-label="类型"><%= service.type %></td>
                  <td data-label="电话"><%= service.phone %></td>
                  <td data-label="状态"><%= statusLabel(service.status) %></td>
                  <td class="table-actions" data-label="操作">
                    <form action="/merchant/services/<%= service.id %>/status" method="post" class="inline-form">
                      <input type="hidden" name="status" value="<%= service.status === "active" ? "inactive" : "active" %>">
                      <button class="button outline small" type="submit"><%= service.status === "active" ? "下架" : "上架" %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
  </section>
  </section>
</section>
<%- include("partials/footer") %>
