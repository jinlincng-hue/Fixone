<% const isNeighbourListing = product.source_type === 'personal_listing' || product.listing_type === 'local_produce' || product.listing_type === 'secondhand'; const itemHref = isNeighbourListing ? `/listings/${product.id}` : `/products/${product.id}`; %>
<article class="item-card"><a class="media-link" href="<%= itemHref %>"><img src="<%= product.image %>" alt="<%= product.name %>"></a><div class="item-body"><div class="item-title-row"><h3><a href="<%= itemHref %>"><%= product.name %></a></h3><% if (product.shop_business_mode === 'home_shop') { %><span class="verify neighbour">乡邻发布</span><% } else if (product.shop_verified) { %><span class="verify">平台已核验</span><% } %></div><p class="muted product-meta"><%= product.category_name || '商品' %> · <%= product.spec %></p><div class="price"><%= yuan(product.price) %><small>/<%= product.unit %></small></div><p class="muted seller-meta"><%= product.shop_name || product.owner_name %> · <%= product.village %></p><div class="tags"><% if (product.pickup) { %><span>可自提</span><% } %><% if (product.delivery) { %><span>可配送</span><% } %><span><%= product.stock_status %></span></div></div></article>
