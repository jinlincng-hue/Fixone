<%- include("partials/header", { title, page }) %>
<% const displayName = (profile.display_name || profile.username || "高桥用户").trim(); %>
<% const avatarLetter = displayName.slice(0, 1); %>

<section class="account-home">
  <header class="account-identity">
    <a class="account-avatar" href="/account/profile" aria-label="编辑账号资料">
      <% if (profile.avatar_url) { %>
        <img src="<%= profile.avatar_url %>" alt="<%= displayName %>的头像">
      <% } else { %>
        <span><%= avatarLetter %></span>
      <% } %>
    </a>
    <a class="account-identity-copy" href="/account/profile">
      <h1><%= displayName %></h1>
      <p><%= profile.village %> · <%= profile.wechat_openid ? "微信已绑定" : "微信待绑定" %><%= profile.phone ? " · 手机号已绑定" : " · 手机号未绑定" %></p>
    </a>
    <a class="account-settings-button" href="/account/settings" aria-label="设置" title="设置">⚙</a>
  </header>

  <section class="account-home-section">
    <div class="account-section-title"><h2>我的交易</h2></div>
    <div class="account-overview-grid">
      <a href="/account/listings">
        <strong><%= listingStats.total || 0 %></strong>
        <span>我发布的</span>
        <small>在售 <%= listingStats.active || 0 %></small>
      </a>
      <a href="/account/wanted">
        <strong><%= wantedStats.total || 0 %></strong>
        <span>全镇求购</span>
        <small>寻找中 <%= wantedStats.seeking || 0 %></small>
      </a>
    </div>
  </section>

  <section class="account-home-section">
    <div class="account-section-title"><h2>常用服务</h2></div>
    <div class="account-menu-list">
      <a href="/account/shops"><span class="account-menu-mark teal">店</span><span><strong>我的店铺</strong><small><%= ownedShop ? ownedShop.name : "还没有开店" %></small></span><b>›</b></a>
      <% if (!ownedShop) { %><a href="/merchant/apply"><span class="account-menu-mark orange">开</span><span><strong>我要开店</strong><small>一个账号只能创建一个店铺</small></span><b>›</b></a><% } %>
      <a href="/account/listings"><span class="account-menu-mark orange">发</span><span><strong>我的发布</strong><small>管理闲置和自家农产品</small></span><b>›</b></a>
      <a href="/account/wanted"><span class="account-menu-mark green">求</span><span><strong>我的求购</strong><small>更新寻找状态和联系方式</small></span><b>›</b></a>
      <a href="/messages"><span class="account-menu-mark amber">息</span><span><strong>消息通知</strong><small>店铺审核和求购状态提醒</small></span><b>›</b></a>
    </div>
  </section>

  <section class="account-home-section">
    <div class="account-section-title"><h2>本地生活</h2></div>
    <div class="account-local-grid">
      <a class="account-local-card runner" href="/services">
        <span class="account-local-icon">跑</span>
        <strong>帮跑腿</strong>
        <small>跑腿代办、维修送水等便民服务</small>
      </a>
      <a class="account-local-card scenic" href="/map">
        <img src="/assets/images/gaoqiao-bridge.png" alt="高桥镇风貌">
        <span>
          <strong>镇上风采</strong>
          <small>高桥风貌和本地位置</small>
        </span>
      </a>
    </div>
  </section>

</section>

<%- include("partials/footer") %>
