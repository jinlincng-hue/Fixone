<%- include("partials/header", { title, page }) %>
<section class="product-view-page">
  <a class="product-view-back" href="/">‹ 返回购物</a>

  <div class="product-view-layout">
    <section class="product-gallery-panel" aria-label="商品图片">
      <% const galleryImages = listing.images && listing.images.length ? listing.images : [{ image_path: listing.image }]; %>
      <div class="product-gallery-strip" data-listing-gallery data-product-gallery>
        <% galleryImages.forEach((image, index) => { %>
          <figure>
            <button class="product-gallery-open" type="button" data-image-open aria-label="查看<%= listing.name %>图片<%= index + 1 %>原图">
              <img class="<%= index === 0 ? 'listing-gallery-cover' : '' %>" src="<%= image.image_path %>" alt="<%= listing.name %>图片<%= index + 1 %>" loading="<%= index === 0 ? 'eager' : 'lazy' %>">
            </button>
            <% if (galleryImages.length > 1) { %><span><%= index + 1 %>/<%= galleryImages.length %></span><% } %>
          </figure>
        <% }) %>
      </div>
      <% if (galleryImages.length > 1) { %><p class="gallery-hint">左右滑动查看更多图片</p><% } %>
      <dialog class="product-image-dialog" data-image-dialog aria-label="查看商品原图">
        <button class="product-image-dialog-close" type="button" data-image-dialog-close aria-label="关闭大图">×</button>
        <img data-image-dialog-image alt="">
      </dialog>
    </section>

    <article class="product-summary-card">
      <div class="product-title-line">
        <h1><%= listing.name %></h1>
        <div class="price large"><%= yuan(listing.price) %><small>/<%= listing.unit %></small></div>
      </div>
      <div class="product-intro-line">
        <span class="verify neighbour"><%= listing.shop_business_mode === 'home_shop' ? '商品已审核 · 乡邻发布' : listing.type === 'farm' ? '自家农货' : '个人闲置' %></span>
        <p><%= listing.description || '卖家暂未填写商品详情。' %></p>
      </div>
      <div class="product-quick-tags">
        <span><%= listing.stock_status %></span>
        <% if (listing.pickup) { %><span>支持自提</span><% } %>
        <% if (listing.delivery) { %><span>支持配送</span><% } %>
      </div>

      <dl class="product-facts">
        <% if (listing.spec) { %><dt>规格</dt><dd><%= listing.spec %></dd><% } %>
        <dt>所在村庄</dt><dd><%= listing.village %></dd>
        <dt>更新时间</dt><dd><%= formatDate(listing.updated_at) %></dd>
      </dl>

      <div class="seller-strip seller-strip-static">
        <span class="seller-avatar">邻</span>
        <span><strong><%= listing.shop_name || listing.owner_name %></strong><small><%= listing.village %>发布</small></span>
      </div>

      <div class="product-contact-actions">
        <% if (currentUser) { %>
          <a class="button primary" href="/contact/listing/<%= listing.id %>">联系卖家</a>
        <% } else { %>
          <a class="button primary" href="/auth?next=<%= encodeURIComponent(`/listings/${listing.id}`) %>">登录后联系</a>
        <% } %>
        <a class="button outline" href="/wanted/new?q=<%= encodeURIComponent(listing.name) %>">发布求购</a>
      </div>
    </article>
  </div>

  <%- include("partials/comments", { targetType: "listing", targetId: listing.id, comments, nextUrl: `/listings/${listing.id}` }) %>

  <details class="compact-report">
    <summary>举报该商品</summary>
    <% if (currentUser) { %>
      <form action="/reports" method="post" class="stack-form">
        <input type="hidden" name="target_type" value="listing">
        <input type="hidden" name="target_id" value="<%= listing.id %>">
        <label>举报原因<input name="reason" maxlength="120" required></label>
        <label>补充说明<textarea name="detail" rows="3" maxlength="800"></textarea></label>
        <button class="button outline" type="submit">提交举报</button>
      </form>
    <% } else { %>
      <p class="muted">请先登录后提交举报。</p>
    <% } %>
  </details>
</section>
<%- include("partials/footer") %>
