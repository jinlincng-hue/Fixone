function requireLoginForUpload() {
  const currentUser = getCurrentUser();
  const locked = qs("#uploadLocked");
  const form = qs("#uploadForm");

  if (!locked || !form) return currentUser;

  if (!currentUser) {
    locked.classList.remove("hidden");
    form.classList.add("hidden");
    return null;
  }

  locked.classList.add("hidden");
  form.classList.remove("hidden");
  return currentUser;
}

function prefillUploaderFromLogin() {
  const currentUser = getCurrentUser();
  if (!currentUser) return;

  const nameInput = qs("#uploaderName");
  const usernameInput = qs("#uploaderUsername");
  if (nameInput) nameInput.value = currentUser.displayName;
  if (usernameInput) usernameInput.value = currentUser.username;
}

function createClipBlock(order) {
  const block = document.createElement("section");
  block.className = "clip-upload-block";
  block.innerHTML = `
    <div class="clip-block-head">
      <h3>切片 ${order}</h3>
      <button class="ghost-button remove-clip-button" type="button">移除</button>
    </div>
    <div class="form-grid">
      <label>
        <span>切片顺序</span>
        <input name="clip_order" type="number" min="1" value="${order}" required>
      </label>
      <label>
        <span>切片标题</span>
        <input name="clip_title" type="text" placeholder="例如：关机并取出卡托" required>
      </label>
      <label class="form-wide">
        <span>切片说明</span>
        <textarea name="clip_description" rows="3" placeholder="说明这一段的维修动作和注意事项"></textarea>
      </label>
      <label class="form-wide">
        <span>视频文件（mp4 / mov / webm）</span>
        <input name="video_file" type="file" accept=".mp4,.mov,.webm,video/mp4,video/quicktime,video/webm" required>
      </label>
    </div>
  `;

  block.querySelector(".remove-clip-button").addEventListener("click", () => {
    if (qsa(".clip-upload-block").length <= 1) return;
    block.remove();
  });

  return block;
}

function addClipBlock() {
  const list = qs("#clipBlocks");
  if (!list) return;
  list.appendChild(createClipBlock(qsa(".clip-upload-block", list).length + 1));
}

async function handleUploadSubmit(event) {
  event.preventDefault();

  if (!getCurrentUser()) {
    alert("请先登录后再上传维修视频。");
    return;
  }

  const form = event.currentTarget;
  const submitButton = qs("#submitUploadButton");
  const message = qs("#uploadMessage");
  const formData = new FormData();
  const clips = [];

  try {
    [
      "uploader_name",
      "uploader_username",
      "contact",
      "title",
      "brand",
      "series",
      "model",
      "repair_part",
      "description"
    ].forEach((name) => {
      formData.append(name, form.elements[name].value.trim());
    });

    formData.append("license_agreed", form.elements.license_agreed.checked ? "1" : "");

    qsa(".clip-upload-block").forEach((block, index) => {
      const fileInput = block.querySelector('[name="video_file"]');
      clips.push({
        clip_order: Number(block.querySelector('[name="clip_order"]').value),
        clip_title: block.querySelector('[name="clip_title"]').value.trim(),
        clip_description: block.querySelector('[name="clip_description"]').value.trim()
      });
      if (fileInput.files[0]) formData.append("video_files", fileInput.files[0]);
      if (!clips[index].clip_order || !clips[index].clip_title || !fileInput.files[0]) {
        throw new Error("请完整填写每个切片的顺序、标题和视频文件。");
      }
    });

    formData.append("clips", JSON.stringify(clips));

    submitButton.disabled = true;
    message.textContent = "正在上传，请不要关闭页面...";
    message.className = "form-message";

    const response = await fetch("/api/repair-video-projects", {
      method: "POST",
      body: formData
    });
    const result = await response.json();
    if (!response.ok || !result.success) throw new Error(result.message || "上传失败");

    message.innerHTML = `${escapeHtml(result.message)}<br>项目名：<a href="admin-projects.html">${escapeHtml(result.projectName || result.projectId)}</a>`;
    message.className = "form-message success";
    form.reset();
    prefillUploaderFromLogin();
    qs("#clipBlocks").innerHTML = "";
    addClipBlock();
  } catch (error) {
    message.textContent = error.message;
    message.className = "form-message error";
  } finally {
    submitButton.disabled = false;
  }
}

function initUploadPage() {
  if (!requireLoginForUpload()) return;
  prefillUploaderFromLogin();
  addClipBlock();
  qs("#addClipButton")?.addEventListener("click", addClipBlock);
  qs("#uploadForm")?.addEventListener("submit", handleUploadSubmit);
}

