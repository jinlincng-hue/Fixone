<%- include("partials/header", { title, page }) %>
<% const displayName = (profile.display_name || profile.username || "FixOne用户").trim(); %>

<section class="account-subpage">
  <header class="account-subpage-header">
    <a class="back-icon" href="/account" aria-label="返回我的" title="返回我的">←</a>
    <div><p class="eyebrow">个人资料</p><h1>账号资料</h1></div>
  </header>

  <form action="/account/profile" method="post" class="profile-data-sheet">
    <div class="profile-avatar-row">
      <span>头像</span>
      <span class="profile-avatar-large">
        <% if (profile.avatar_url) { %><img src="<%= profile.avatar_url %>" alt="<%= displayName %>的头像"><% } else { %><b><%= displayName.slice(0, 1) %></b><% } %>
      </span>
    </div>
    <label class="profile-edit-row"><span>昵称</span><input name="username" required minlength="2" maxlength="60" value="<%= profile.username %>"></label>
    <label class="profile-edit-row"><span>手机号</span><input name="phone" maxlength="40" value="<%= profile.phone || '' %>" placeholder="未绑定"></label>
    <label class="profile-edit-row"><span>所在村或社区</span><input name="village" required maxlength="80" value="<%= profile.village %>"></label>
    <div class="profile-status-row"><span>微信</span><span><%= profile.wechat_openid ? "已绑定" : "未绑定" %></span></div>
    <button class="button primary profile-save-button" type="submit">保存资料</button>
  </form>

  <section class="account-form-section profile-wechat-section">
    <h2>微信登录</h2>
    <% if (profile.wechat_openid) { %>
      <p class="form-success">当前微信已绑定。未绑定手机号时，之后主要通过当前微信登录。</p>
    <% } else { %>
      <p class="muted">绑定微信后可直接登录。手机号不是注册或店铺入驻的前置条件。</p>
      <a class="button outline" href="/account/wechat/bind">绑定微信</a>
    <% } %>
  </section>
</section>

<%- include("partials/footer") %>
