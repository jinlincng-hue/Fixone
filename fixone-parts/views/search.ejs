<%- include("partials/header", { title, page }) %>
<section class="page-hero small-hero">
  <div>
    <h1>搜索结果</h1>
    <p><%= q ? `“${q}” 的相关商品、商家、服务和求购` : "输入关键词查找FixOne配件库本地信息" %></p>
  </div>
  <form action="/search" method="get" class="inline-search">
    <input type="search" name="q" value="<%= q %>" placeholder="输入商品或服务">
    <button class="button primary" type="submit">搜索</button>
  </form>
</section>

<% const total = products.length + listings.length + shops.length + services.length + wanted.length; %>
<% if (!q) { %>
  <%- include("partials/empty", { message: "请输入关键词开始搜索。", actionHref: "/products", actionText: "浏览附近商品" }) %>
<% } else if (!total) { %>
  <%- include("partials/empty", { message: "暂时没有搜到，可以把需求发到全镇求购。", actionHref: `/wanted/new?q=${encodeURIComponent(q)}`, actionText: "帮我问全镇" }) %>
<% } else { %>
  <% if (products.length) { %>
    <div class="section-heading"><h2>商家商品</h2></div>
    <section class="product-grid wide">
      <% products.forEach((product) => { %><%- include("partials/product-card", { product }) %><% }) %>
    </section>
  <% } %>
  <% if (listings.length) { %>
    <div class="section-heading"><h2>个人发布</h2></div>
    <section class="product-grid wide">
      <% listings.forEach((listing) => { %><%- include("partials/listing-card", { listing }) %><% }) %>
    </section>
  <% } %>
  <% if (shops.length) { %>
    <div class="section-heading"><h2>本地商家</h2></div>
    <section class="shop-grid">
      <% shops.forEach((shop) => { %><%- include("partials/shop-card", { shop }) %><% }) %>
    </section>
  <% } %>
  <% if (services.length) { %>
    <div class="section-heading"><h2>便民服务</h2></div>
    <section class="service-grid">
      <% services.forEach((service) => { %>
        <article class="service-card">
          <img src="<%= service.image %>" alt="<%= service.title %>">
          <h3><%= service.title %></h3>
          <p><%= service.description %></p>
        </article>
      <% }) %>
    </section>
  <% } %>
  <% if (wanted.length) { %>
    <div class="section-heading"><h2>全镇求购</h2></div>
    <section class="wanted-board">
      <% wanted.forEach((post) => { %>
        <article class="wanted-card">
          <h3><%= post.title %></h3>
          <p>预算：<%= post.budget || "面议" %></p>
          <p><%= post.village %> · <%= post.needs_delivery ? "需要配送" : "可自提或电话沟通" %></p>
          <span><%= statusLabel(post.status) %></span>
        </article>
      <% }) %>
    </section>
  <% } %>
<% } %>
<%- include("partials/footer") %>
