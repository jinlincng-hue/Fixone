<section class="empty-state empty-state-enhanced">
  <div class="empty-icon">
    <svg viewBox="0 0 64 64" width="56" height="56" fill="none">
      <circle cx="32" cy="32" r="28" stroke="#0a6a5f" stroke-width="2" stroke-dasharray="4 4" opacity="0.4"/>
      <path d="M20 26 L44 26 M20 34 L36 34" stroke="#0a6a5f" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
      <circle cx="46" cy="42" r="8" fill="#f5c842" opacity="0.3"/>
      <path d="M42 42 L46 46 L52 38" stroke="#0a6a5f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <p class="empty-message"><%= message %></p>
  <% if (actionHref && actionText) { %>
    <a class="button primary" href="<%= actionHref %>"><%= actionText %></a>
  <% } %>
</section>
<style>
.empty-state-enhanced { text-align: center; padding: 48px 20px; }
.empty-state-enhanced .empty-icon { margin-bottom: 16px; display: flex; justify-content: center; }
.empty-state-enhanced .empty-message { color: #666; font-size: 15px; margin: 0 0 20px; line-height: 1.6; }
</style>
