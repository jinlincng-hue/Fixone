<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title ? `${title} - FixOne配件库` : "FixOne配件库" %></title>
    <meta name="description" content="FixOne配件库 — FixOne配件库本地商品、商家与便民服务平台，邻里互助，就近交易。">
    <link rel="icon" type="image/png" href="/assets/images/logo.png">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= title ? `${title} - FixOne配件库` : 'FixOne配件库' %>">
    <meta property="og:description" content="FixOne配件库本地商品、商家与便民服务平台，邻里互助，就近交易。">
    <meta property="og:image" content="https://parts.fixone.cloud/assets/images/logo.png">
    <meta property="og:url" content="https://parts.fixone.cloud">
    <meta property="og:site_name" content="FixOne配件库">
    <meta name="keywords" content="FixOne,配件库,二手交易,本地商家,便民服务,FixOne配件库,农产品,闲置,邻里互助">
    <meta name="robots" content="index,follow">
    <meta name="author" content="FixOne配件库">
    <link rel="canonical" href="https://parts.fixone.cloud">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FixOne配件库",
      "url": "https://parts.fixone.cloud",
      "description": "FixOne配件库本地商品、商家与便民服务平台，邻里互助，就近交易。",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://parts.fixone.cloud/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <link rel="stylesheet" href="/styles.css?v=20260904h">
  <script>
    (function(){
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch(e) {}
    })();
  </script>
  </head>
  <body>
    <header class="site-header">
      <div class="topbar">
        <a class="brand" href="/" aria-label="FixOne配件库首页">
          <img class="brand-logo" src="/assets/images/logo.png" alt="FixOne配件库" style="width:32px;height:32px;border-radius:6px;object-fit:cover;margin-right:8px;vertical-align:middle;">
          <span class="brand-script">FixOne</span>
          <span class="brand-rest"> · 配件库</span>
        </a>
        <% if (page === 'home') { %>
          <form class="top-search" action="/search" method="get">
            <input type="search" name="q" placeholder="搜商品、商家、服务" aria-label="搜索商品、商家、服务">
            <button type="submit" aria-label="搜索">搜索</button>
          </form>
        <% } %>
      </div>
    </header>
    <main>
      <% if (flash) { %>
        <div class="flash <%= flash.type %>" data-auto-close-flash><%= flash.message %></div>
      <% } %>
