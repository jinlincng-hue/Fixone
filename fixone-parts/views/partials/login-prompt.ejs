<% if (!currentUser) { %>
  <section class="login-prompt" data-login-prompt role="dialog" aria-modal="true" aria-labelledby="login-prompt-title">
    <div class="login-prompt-backdrop" data-login-prompt-close></div>
    <div class="login-prompt-card">
      <button class="login-prompt-close" type="button" data-login-prompt-close aria-label="暂不登录">×</button>
      <p class="eyebrow">FixOne配件库</p>
      <h2 id="login-prompt-title">请登录</h2>
      <p class="muted">登录后可发布信息、联系商家和保存店铺草稿。</p>
      <% if (wechatConfigured) { %>
        <a class="button primary wechat-login-button" href="/auth/wechat?next=<%= encodeURIComponent(nextUrl || '/') %>">微信一键登录</a>
      <% } else if (wechatDevLoginEnabled) { %>
        <form action="/auth/wechat/dev" method="post" class="login-prompt-dev-form">
          <input type="hidden" name="next" value="<%= nextUrl || '/' %>">
          <input type="hidden" name="openid" value="home_visitor">
          <button class="button primary wechat-login-button" type="submit">微信测试登录</button>
        </form>
      <% } else { %>
        <a class="button primary wechat-login-button" href="/auth?next=<%= encodeURIComponent(nextUrl || '/') %>">微信登录</a>
      <% } %>
      <div class="login-prompt-account-actions">
        <a class="button light" href="/auth?next=<%= encodeURIComponent(nextUrl || '/') %>">账号密码登录</a>
        <a class="button outline" href="/register?next=<%= encodeURIComponent(nextUrl || '/') %>">新用户注册</a>
      </div>
    </div>
  </section>
  <script>
  (function(){
    var p = document.querySelector('[data-login-prompt]');
    if (!p) return;
    if (localStorage.getItem('guestDismissLogin') === '1') {
      p.style.display = 'none';
      return;
    }
    p.querySelectorAll('[data-login-prompt-close]').forEach(function(el){
      el.addEventListener('click', function(){
        p.style.display = 'none';
        localStorage.setItem('guestDismissLogin', '1');
      });
    });
  })();
  </script>
<% } %>
