<%- include("partials/auth-start", { title }) %>
<section class="simple-auth-shell">
  <article class="simple-auth-card">
    <p class="eyebrow">FixOne配件库</p>
    <h1>请登录</h1>
    <p class="muted">先用微信登录，需要开店时再提交商家认证。</p>

    <% if (notice) { %><p class="form-success"><%= notice %></p><% } %>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <% if (wechatConfigured) { %>
      <a class="button primary wechat-login-button" href="/auth/wechat?next=<%= encodeURIComponent(nextUrl) %>">微信一键登录</a>
    <% } else if (wechatDevLoginEnabled) { %>
      <form action="/auth/wechat/dev" method="post" class="dev-login-form">
        <input type="hidden" name="next" value="<%= nextUrl %>">
        <input type="hidden" name="openid" value="merchant_demo">
        <button class="button primary wechat-login-button" type="submit">微信测试登录</button>
      </form>
    <% } else { %>
      <p class="wechat-unavailable">微信登录暂未开通</p>
    <% } %>

    <details class="simple-auth-details" open>
      <summary>账号密码登录</summary>
      <form action="/login" method="post" class="stack-form">
        <input type="hidden" name="next" value="<%= nextUrl %>">
        <label>用户名<input name="username" required autocomplete="username"></label>
        <label>密码<input name="password" type="password" required autocomplete="current-password"></label>
        <button class="button outline" type="submit">登录</button>
      </form>
    </details>

    <p class="auth-switch">没有账号？<a href="/register?next=<%= encodeURIComponent(nextUrl) %>">去注册</a></p>
  </article>
</section>
<%- include("partials/auth-end") %>
