NODE_ENV=development
PORT=3000
DB_PATH=data/fixone-parts.sqlite

# 生产环境必须设置足够长、随机的 SESSION_SECRET；开发环境未设置时会使用临时随机值。
SESSION_SECRET=

# 初始化管理员账号密码，可在首次初始化前覆盖。
ADMIN_PASSWORD=Admin12345!

# 微信网页 OAuth（仅在服务端读取；不要把 AppSecret 放到前端或提交到 Git）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 例如：https://your-domain.example/auth/wechat/callback
WECHAT_REDIRECT_URI=

# 仅本地开发时设为 true，会显示一个不访问微信平台的测试登录入口。
# NODE_ENV=production 时该入口始终自动禁用。
WECHAT_DEV_LOGIN=false
